{
  "name": "anime4k-webgpu-async",
  "version": "3.3.0",
  "description": "Anime4K WebGPU port",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "vite build",
    "dev": "nodemon",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:preset-parity": "node scripts/check-preset-parity.cjs",
    "check:packaging": "node scripts/check-packaging.cjs",
    "verify": "pnpm build && pnpm check:preset-parity && pnpm check:packaging && pnpm lint && pnpm format:check"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,js,wgsl",
    "exec": "pnpm run build"
  },
  "files": [
    "dist/",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engines": {
      "types": "./dist/engines/index.d.ts",
      "default": "./dist/engines/index.js"
    },
    "./engines/anime4k": {
      "types": "./dist/engines/anime4k/index.d.ts",
      "default": "./dist/engines/anime4k/index.js"
    },
    "./engines/anime4k/catalog": {
      "types": "./dist/engines/anime4k/catalog.d.ts",
      "default": "./dist/engines/anime4k/catalog.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daika7ana/Anime4K-WebGPU-Async.git"
  },
  "keywords": [
    "upscale",
    "webgpu",
    "video",
    "anime",
    "supersampling"
  ],
  "author": "Anime4KWebBoost Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/daika7ana/Anime4K-WebGPU-Async/issues"
  },
  "homepage": "https://github.com/daika7ana/Anime4K-WebGPU-Async#readme",
  "peerDependencies": {
    "@webgpu/types": "^0.1.72"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.6",
    "@webgpu/types": "^0.1.72",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.3.0"
  }
}
